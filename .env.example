# ---------------------------------------------------------------------------
# Hook Explorer environment variables
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# EVERY variable here is optional. With none of them set, the app runs against
# public RPC endpoints and simply skips the source-verification check. Setting
# them makes it faster and more reliable, and unlocks verification.
#
# Never commit `.env.local` -- it is gitignored.
# ---------------------------------------------------------------------------


# --- RPC endpoints ---------------------------------------------------------
#
# Override the public default for each chain. Strongly recommended: the public
# endpoints are heavily rate-limited and cap `eth_getLogs` ranges, which is
# exactly what the pool scan depends on. Any standard JSON-RPC HTTPS URL works
# (Alchemy, Infura, QuickNode, dRPC, your own node).
#
# Defaults, used when unset:
#   RPC_URL_ETHEREUM  https://ethereum-rpc.publicnode.com
#   RPC_URL_BASE      https://mainnet.base.org
#   RPC_URL_UNICHAIN  https://mainnet.unichain.org
#   RPC_URL_ARBITRUM  https://arb1.arbitrum.io/rpc

RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_UNICHAIN=
RPC_URL_ARBITRUM=


# --- Block explorer --------------------------------------------------------
#
# A single Etherscan V2 API key covers every supported chain (Etherscan,
# Basescan, Uniscan, Arbiscan) -- V2 selects the network with a `chainid`
# parameter rather than a per-chain host and key.
#
# Get a free key at https://etherscan.io/myapikey
#
# When unset, the app degrades gracefully: source verification is reported as
# "not checked" with an explanatory note, and nothing else is affected.

ETHERSCAN_API_KEY=


# --- Pool scan tuning ------------------------------------------------------
#
# The v4 `Initialize` event does not index the hook address, so pools cannot be
# filtered at the RPC layer. The scan fetches all Initialize logs over a range
# of blocks and filters client-side, which makes it inherently range-limited.
#
# These control how far back it looks and how hard it hits the RPC.
#
#   POOL_SCAN_CHUNK_SIZE   blocks per eth_getLogs call     (default 9000)
#   POOL_SCAN_MAX_CHUNKS   maximum eth_getLogs calls       (default 12)
#   POOL_SCAN_MAX_RESULTS  stop after this many pools      (default 100)
#
# Default coverage is 9000 x 12 = 108,000 blocks back from head. With a paid
# RPC that permits wider ranges, raising CHUNK_SIZE is the cheapest way to
# cover more history.

POOL_SCAN_CHUNK_SIZE=
POOL_SCAN_MAX_CHUNKS=
POOL_SCAN_MAX_RESULTS=
